# I/O config
input U data
input clk clock
input prch precharge
input r randomness
output S data

# Algorithm
# XOR z = a ^ b or z = XOR2(a,b)
# AND z = a & b or z = AND2(a,b)
# NAND z = a ~& b or z = NAND2(a,b)
# OR z = a | b or z = OR2(a,b)
# NOR z = a ~| b or z = NOR2(a,b)
# XNOR z = a ~^ b or z = XNOR2(a,b)
# NOT z = ~ a or z = NOT(a)

